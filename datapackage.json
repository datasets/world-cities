    }
  ],
  "resources": [
    {
      "name": "world-cities",
      "path": "data/world-cities.csv",
      "description": "List of major cities of the world (more than 15,000 inhabitants, plus capitals and seats of government of any size), from GeoNames. Each city is identified by its name, country, first-level region (subcountry) and GeoNames id.",
      "format": "csv",
      "mediatype": "text/csv",
      "schema": {
        "fields": [
          {
            "name": "name",
            "description": "Name of the city (GeoNames name, UTF-8)",
            "type": "string"
          },
          {
            "name": "country",
            "description": "Country name (ISO 3166-1 official short name from pycountry, for example 'Viet Nam'; 'Kosovo' is added by the script)",
            "type": "string"
          },
          {
            "name": "subcountry",
            "description": "ASCII name of the first-level region (state or major administrative area); empty where GeoNames has none",
            "type": "string"
          },
          {
            "name": "geonameid",
            "description": "GeoNames id of the city",
            "type": "integer"
          }
        ]
      },
      "primaryKey": "geonameid"
    }
  ],
  "homepage": "https://github.com/datasets/world-cities",
